{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Azure Deployment Studio",
  "version": "0.1.0",
  "identifier": "dev.azd-gui.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Azure Deployment Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../catalog/azd-gui.catalog.json",
      "../catalog/manifests/*.json",
      "../schemas/*.json"
    ],
    "shortDescription": "Guided Azure Developer CLI deployments",
    "longDescription": "Discover trusted azd templates, configure environments, validate prerequisites, authenticate required tools, and deploy to Azure.",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}

{
  "name": "azd-gui",
  "private": true,
  "version": "0.1.1",
  "license": "Unlicense",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:powershell": "pwsh -NoLogo -NoProfile -NonInteractive -File scripts/test-powershell.ps1",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "format:native": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint:native": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "audit:npm": "npm audit --audit-level=high",
    "audit:cargo": "cargo audit --file src-tauri/Cargo.lock --deny warnings",
    "audit:dependencies": "npm run audit:npm && npm run audit:cargo",
    "ci": "npm run check && npm test && npm run build",
    "verify": "npm run ci && npm run test:powershell && npm run format:native && npm run lint:native && npm run test:native",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^24.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^26.1.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.0.0"
  }
}

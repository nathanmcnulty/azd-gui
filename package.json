{
  "name": "azd-gui",
  "private": true,
  "version": "0.1.3",
  "license": "Unlicense",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:powershell": "pwsh -NoLogo -NoProfile -NonInteractive -File scripts/test-powershell.ps1",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "format:native": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint:native": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "audit:npm": "npm audit --audit-level=high",
    "audit:cargo": "cargo audit --file src-tauri/Cargo.lock --deny warnings && cargo audit --file src-tauri/audit/tauri-utils-crates-io.lock --deny warnings",
    "audit:dependencies": "npm run audit:npm && npm run audit:cargo",
    "ci": "npm run check && npm test && npm run build",
    "verify": "npm run ci && npm run test:powershell && npm run format:native && npm run lint:native && npm run test:native",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "svelte": "^5.59.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^24.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^31.0.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}

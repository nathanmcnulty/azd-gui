{
  "$schema": "../../schemas/azd-gui.schema.json",
  "schemaVersion": "1.0",
  "minimumAzdVersion": "1.23.0",
  "requiresInteractiveTerminal": true,
  "prerequisites": [
    {
      "id": "azd",
      "name": "Azure Developer CLI",
      "kind": "tool",
      "minimumVersion": "1.23.0",
      "required": true,
      "installProvider": "manual"
    },
    {
      "id": "az-cli",
      "name": "Azure CLI",
      "kind": "tool",
      "minimumVersion": "2.60.0",
      "required": true,
      "installProvider": "azdTool",
      "installId": "az-cli",
      "documentationUrl": "https://learn.microsoft.com/cli/azure/install-azure-cli"
    },
    {
      "id": "pwsh",
      "name": "PowerShell",
      "kind": "tool",
      "minimumVersion": "7.4.0",
      "required": true,
      "installProvider": "manual",
      "documentationUrl": "https://learn.microsoft.com/powershell/scripting/install/installing-powershell"
    }
  ],
  "connections": [
    {
      "id": "azd",
      "name": "Azure Developer CLI",
      "required": true,
      "reason": "Provision monitoring infrastructure."
    },
    {
      "id": "azureCli",
      "name": "Azure CLI",
      "required": true,
      "scopes": ["https://management.azure.com/.default", "https://graph.microsoft.com/.default"],
      "reason": "Configure Teams, Azure Resource Manager, and Microsoft Graph resources in template hooks."
    }
  ],
  "configuration": {
    "groups": [
      {
        "id": "logicApps",
        "title": "Entra health alerts",
        "description": "Choose the alert workflow name and target Teams channel used by the pinned template.",
        "fields": [
          {
            "id": "logicAppName",
            "environmentVariable": "LOGIC_APP_NAME",
            "label": "Alert Logic App name",
            "type": "text",
            "required": true,
            "default": "la-entra-health-alerts"
          },
          {
            "id": "teamsChannelLink",
            "environmentVariable": "TEAMS_CHANNEL_LINK",
            "label": "Teams channel link",
            "type": "text",
            "required": true,
            "placeholder": "https://teams.microsoft.com/l/channel/...",
            "help": "In Teams, right-click the target channel and choose Copy link."
          }
        ]
      }
    ]
  },
  "permissionChecks": [
    {
      "id": "azure-subscription-access",
      "name": "Azure subscription access",
      "provider": "azure",
      "required": true,
      "description": "Azure CLI can complete a live ARM read of the selected enabled subscription in the selected tenant."
    },
    {
      "id": "graph-directory-read",
      "name": "Microsoft Graph directory access",
      "provider": "graph",
      "required": true,
      "description": "Azure CLI can query Microsoft Graph for the selected tenant before setup hooks run."
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.azd-gui.dev/v1/azd-gui.schema.json",
  "title": "Azure Deployment Studio template manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "prerequisites", "connections", "configuration"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "enum": ["1.0", "1.1"] },
    "minimumAzdVersion": { "type": "string" },
    "requiresInteractiveTerminal": { "type": "boolean" },
    "prerequisites": {
      "type": "array",
      "items": { "$ref": "#/$defs/prerequisite" }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups"],
      "properties": {
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        }
      }
    },
    "recommendationProfiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/recommendationProfile" },
      "uniqueItems": true
    },
    "permissionChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/permissionCheck" }
    }
  },
  "allOf": [{
    "if": { "properties": { "schemaVersion": { "const": "1.0" } } },
    "then": { "properties": {
      "prerequisites": { "type": "array", "items": { "type": "object", "properties": { "condition": { "$ref": "#/$defs/legacyRequirementCondition" } } } },
      "connections": { "type": "array", "items": { "type": "object", "properties": {
        "scopeGroups": false,
        "condition": { "$ref": "#/$defs/legacyRequirementCondition" }
      } } },
      "permissionChecks": { "type": "array", "items": { "type": "object", "properties": { "condition": { "$ref": "#/$defs/legacyRequirementCondition" } } } }
    } },
    "else": { "properties": { "connections": {
      "type": "array",
      "items": { "type": "object", "properties": { "scopes": {
        "type": "array", "maxItems": 64,
        "items": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9:/._-]+$" }
      } } },
      "allOf": [
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "azd" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "azureCli" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "azPowerShell" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "graphPowerShell" } } }, "minContains": 0, "maxContains": 1 }
      ]
    } } }
  }],
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "type": "string" },
        "equals": { "type": ["string", "boolean"] },
        "notEquals": { "type": ["string", "boolean"] },
        "includes": { "type": "string" }
      },
      "oneOf": [
        { "required": ["equals"], "properties": { "equals": {} } },
        { "required": ["notEquals"], "properties": { "notEquals": {} } },
        { "required": ["includes"], "properties": { "includes": {} } }
      ]
    },
    "requirementCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "equals"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "equals": { "type": ["boolean", "string"] }
      }
    },
    "legacyRequirementCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "equals"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "equals": { "type": "boolean" }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "required"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "enum": ["tool", "powershellModule"] },
        "minimumVersion": { "type": "string" },
        "condition": { "$ref": "#/$defs/requirementCondition" },
        "required": { "type": "boolean" },
        "installProvider": { "enum": ["azdTool", "psResource", "manual"] },
        "installId": { "type": "string" },
        "documentationUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "required", "reason"],
      "properties": {
        "id": { "enum": ["azd", "azureCli", "azPowerShell", "graphPowerShell"] },
        "name": { "type": "string" },
        "condition": { "$ref": "#/$defs/requirementCondition" },
        "required": { "type": "boolean" },
        "reason": { "type": "string" },
        "scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "scopeGroups": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/scopeGroup" } }
      },
      "allOf": [{
        "if": { "properties": { "scopeGroups": {} }, "required": ["scopeGroups"] },
        "then": { "properties": { "id": { "const": "graphPowerShell" } } }
      }]
    },
    "scopeGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scopes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$" },
        "condition": { "$ref": "#/$defs/requirementCondition" },
        "scopes": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9:/._-]+$" } }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "environmentVariable", "label", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "environmentVariable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "label": { "type": "string" },
        "type": {
          "enum": [
            "text",
            "secret",
            "boolean",
            "acknowledgement",
            "select",
            "multiselect",
            "tenant",
            "subscription",
            "location",
            "resourceGroup",
            "entraObject"
          ]
        },
        "required": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "lookup": { "enum": ["securityGroup"] },
        "help": { "type": "string" },
        "validationMessage": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "string" },
        "default": { "type": ["string", "boolean", "array"], "items": { "type": "string" } },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "pattern": { "type": "string" },
        "condition": { "$ref": "#/$defs/condition" }
      },
      "allOf": [
        {
          "if": { "properties": { "lookup": {} }, "required": ["lookup"] },
          "then": { "properties": { "type": { "const": "entraObject" }, "sensitive": { "const": false } } }
        },
        {
          "if": { "properties": { "type": { "const": "acknowledgement" } }, "required": ["type"] },
          "then": {
            "required": ["required", "condition"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "required": { "const": true },
              "condition": { "$ref": "#/$defs/condition" },
              "sensitive": { "const": false },
              "default": false,
              "lookup": false,
              "options": false,
              "pattern": false,
              "placeholder": false
            }
          },
          "else": { "properties": { "validationMessage": false } }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "fields"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "condition": { "$ref": "#/$defs/condition" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" }, "minItems": 1 }
      }
    },
    "recommendationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "values"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "boolean", "array"],
            "items": { "type": "string" }
          }
        }
      }
    },
    "permissionCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "provider", "required", "description"],
      "properties": {
        "id": {
          "enum": [
            "azure-subscription-access",
            "graph-directory-read",
            "graph-delegated-scopes",
            "entra-directory-access"
          ]
        },
        "name": { "type": "string" },
        "provider": { "enum": ["azure", "graph"] },
        "condition": { "$ref": "#/$defs/requirementCondition" },
        "required": { "type": "boolean" },
        "description": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "id": { "const": "azure-subscription-access" } } },
          "then": { "properties": { "provider": { "const": "azure" } } },
          "else": { "properties": { "provider": { "const": "graph" } } }
        }
      ]
    }
  }
}
